# Öffentliche URL der Website (für Links in E-Mails und .ics)
NEXT_PUBLIC_SITE_URL=https://www.reskin-studio.ch

# --- Admin-Login ---
ADMIN_EMAIL=info@reskin-studio.ch
# Passwort im Klartext ODER (empfohlen) als SHA-256-Hex in ADMIN_PASSWORD_SHA256
ADMIN_PASSWORD=bitte-aendern
# ADMIN_PASSWORD_SHA256=
# Zufälliger, langer Schlüssel für die Sitzungs-Cookies (z. B. `openssl rand -hex 32`)
AUTH_SECRET=bitte-durch-langen-zufallswert-ersetzen

# --- Datenbank (Supabase) ---
# Ohne diese Werte speichert die Website lokal in .data/db.json (nur für Entwicklung!)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-Mails (Resend) ---
# Ohne Key werden E-Mails nur in der Konsole ausgegeben
RESEND_API_KEY=
EMAIL_FROM="RE|SKIN <termine@reskin-studio.ch>"
# Empfänger für Buchungs- und Kontakt-Benachrichtigungen
STUDIO_EMAIL=info@reskin-studio.ch

# Schutz für den Erinnerungs-Cron (/api/cron/reminders)
CRON_SECRET=bitte-aendern
