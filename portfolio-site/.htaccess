# Zeichensatz auch im HTTP-Header angeben
AddDefaultCharset UTF-8

# Eine einzige Adresse: https://ardit.ch/ (ohne www, ohne index.html)
RewriteEngine On

# http -> https (prüft beide Wege, damit es auch hinter einem Proxy keine Schleife gibt)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://ardit.ch/$1 [R=301,L]

# www -> ohne www
RewriteCond %{HTTP_HOST} ^www\.ardit\.ch$ [NC]
RewriteRule ^(.*)$ https://ardit.ch/$1 [R=301,L]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://ardit.ch/ [R=301,L]

# Bilder lange im Browser behalten, die Seite selbst kurz
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Fehlerseite nicht auflisten lassen
Options -Indexes
